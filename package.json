{
  "name": "avenlyo-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --import tsx server/index.ts",
    "dev:local": "node --watch --import tsx server/index.ts --local-workspace",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts --production",
    "start:local": "node --import tsx server/index.ts --production --local-workspace",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "openai": "6.9.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
